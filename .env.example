# Copy to .env and fill in. .env is gitignored — verify before every commit.
# Credentials are read from the environment only. They are never persisted by the
# collector, never logged, and never leave the customer's boundary.
#
# ALL SCOPES BELOW ARE READ-ONLY. Enforcement (key revocation, budget hard-stops)
# requires separately-granted write scopes and is opt-in per action — see
# docs/REQUIREMENTS.md F6.

# --- Anthropic -----------------------------------------------------------------
# Admin key (sk-ant-admin...), NOT a normal API key. Console > Settings > Organization.
# Only org admins can provision one; unavailable on individual accounts.
# Usage & Cost API: data lands within ~5 min, poll limit 1/min.
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_ORG_ID=

# --- OpenAI --------------------------------------------------------------------
# Org admin key with api.usage.read / api.costs.read.
OPENAI_ADMIN_KEY=
OPENAI_ORG_ID=

# --- GCP / Vertex --------------------------------------------------------------
# The ₹6 crore surface. Service account needs:
#   roles/bigquery.dataViewer on the billing export dataset
#   roles/monitoring.viewer for near-real-time metrics
# Point at the JSON key path; never commit the key itself.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_BILLING_PROJECT=
GCP_BILLING_DATASET=
GCP_BILLING_TABLE=

# --- AWS Bedrock ---------------------------------------------------------------
# Prefer an assumed role over long-lived keys. Needs CUR S3 read + cloudwatch:GetMetricData.
AWS_REGION=
AWS_CUR_BUCKET=
AWS_CUR_PREFIX=

# --- Azure OpenAI --------------------------------------------------------------
# Service principal with Cost Management Reader.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- GitHub Copilot ------------------------------------------------------------
# BOTH are required. Org-level usage metrics alone will NOT surface cost — billing
# lives at the enterprise level. See docs/REQUIREMENTS.md F1.
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_ENTERPRISE=

# --- Storage -------------------------------------------------------------------
PRAHARI_DUCKDB_PATH=data/warehouse/prahari.duckdb
# Postgres only for the multi-tenant control plane; unused by the collector.
# PRAHARI_POSTGRES_DSN=

# --- Presentation --------------------------------------------------------------
PRAHARI_DISPLAY_CURRENCY=INR
PRAHARI_FX_SOURCE=rbi_reference
