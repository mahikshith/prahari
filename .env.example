# Copy to .env and fill in. .env is gitignored — verify before every commit.
# Supply API credentials through environment variables; prefer keyless ADC on GCP.
# Keep .env and key files within the customer's environment and out of build context.
#
# ALL SCOPES BELOW ARE READ-ONLY. Enforcement (key revocation, budget hard-stops)
# is future work, requires separately-granted write scopes and is opt-in per action — see
# docs/REQUIREMENTS.md F6.

# --- Anthropic -----------------------------------------------------------------
# Admin key (sk-ant-admin...), NOT a normal API key. Console > Settings > Organization.
# Only org admins can provision one; unavailable on individual accounts.
# Usage & Cost API: poll limit 1/min; measure delivery freshness in the pilot.
ANTHROPIC_ADMIN_KEY=

# --- OpenAI --------------------------------------------------------------------
# Org admin key with api.usage.read / api.costs.read.
OPENAI_ADMIN_KEY=

# --- GCP / Vertex --------------------------------------------------------------
# The ₹6 crore surface. The ADC principal needs:
#   roles/bigquery.dataViewer on the billing export dataset
#   roles/bigquery.jobUser on the query project
# Optional ADC credential-file path; workload identity needs no key file.
# If a JSON key is required, mount it read-only and never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_BILLING_PROJECT=
GCP_BILLING_DATASET=
GCP_BILLING_TABLE=

# --- AWS Bedrock (future; unused by this collector) -----------------------------
# Prefer an assumed role over long-lived keys. Needs CUR S3 read + cloudwatch:GetMetricData.
AWS_REGION=
AWS_CUR_BUCKET=
AWS_CUR_PREFIX=

# --- Azure OpenAI (future; unused by this collector) ----------------------------
# Service principal with Cost Management Reader.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# --- GitHub Copilot (future; unused by this collector) ---------------------------
# BOTH are required. Org-level usage metrics alone will NOT surface cost — billing
# lives at the enterprise level. See docs/REQUIREMENTS.md F1.
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_ENTERPRISE=

# --- Storage -------------------------------------------------------------------
# Optional override of store.path in YAML; Compose selects the mounted /data volume.
# PRAHARI_DUCKDB_PATH=data/warehouse/prahari.duckdb
# Postgres only for the multi-tenant control plane; unused by the collector.
# PRAHARI_POSTGRES_DSN=

# --- Presentation --------------------------------------------------------------
# Configure display_currency and dated fx_rates in prahari.yaml.
# Configure provider account IDs under collectors[].account_id in the same YAML.
